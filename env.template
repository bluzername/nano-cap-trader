# Copy to .env and fill in. Every variable maps 1:1 to a field in app/config.py.
# Only POLYGON_API_KEY is required; everything else has a default.

# ---- Required ---------------------------------------------------------------
POLYGON_API_KEY=your_polygon_api_key_here

# ---- Storage ----------------------------------------------------------------
# DB_URL is still accepted as an alias.
DATABASE_URL=sqlite:///data.db

# ---- Portfolio limits -------------------------------------------------------
MAX_POSITION_VALUE=8000.0
MAX_PORTFOLIO_VALUE=50000.0
MAX_DAILY_TRADES=100

# ---- Composite signal weights ----------------------------------------------
INSIDER_WEIGHT=0.30
GAPREV_WEIGHT=0.10
ALT_GROWTH_WEIGHT=0.25
SHORT_WEIGHT=0.15
MOMO_WEIGHT=0.20

# ---- Short interest data (optional) ----------------------------------------
USE_ORTEX=false
# ORTEX_KEY is still accepted as an alias.
ORTEX_TOKEN=
FINNHUB_API_KEY=
FMP_API_KEY=
FINRA_SHORT_SALE_URL=https://api.finra.org/data/group/otcMarket/name/regShoDaily
FINRA_SHORT_INTEREST_URL=https://api.finra.org/data/group/otcMarket/name/shortInterest
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FMP_BASE_URL=https://financialmodelingprep.com/api/v4

# ---- News and fundamentals (optional) --------------------------------------
NEWSAPI_KEY=
# ALPHA_VANTAGE_KEY is still accepted as an alias.
ALPHA_VANTAGE_API_KEY=

# ---- Strategy selection -----------------------------------------------------
# Comma-separated. Available: statistical_arbitrage, momentum, mean_reversion,
# multi_strategy, insider_momentum_advanced, insider_options_flow, insider_ml_predictor
ENABLED_STRATEGIES=multi_strategy
MOMENTUM_VOLUME_THRESHOLD=3.0
STAT_ARB_CORRELATION_THRESHOLD=0.8
MEAN_REV_BB_STD_DEV=2.0
# Multi-strategy weights (should sum to 1.0)
MULTI_STAT_ARB_WEIGHT=0.60
MULTI_MOMENTUM_WEIGHT=0.25
MULTI_MEAN_REV_WEIGHT=0.15

# ---- Risk management --------------------------------------------------------
ENABLE_POSITION_SIZING=true
ENABLE_STOP_LOSS=true
ENABLE_SHORT_SELLING=false
MAX_VOLUME_PCT=0.005
TRANSACTION_COST_PCT=0.001
MIN_TRANSACTION_COST=20.0
MIN_POSITION_VALUE=4000.0

# ---- Enhanced insider data sources (optional, paid) -------------------------
FINTEL_API_KEY=
WHALEWISDOM_API_KEY=
TRADIER_API_KEY=
BENZINGA_API_KEY=

# ---- Remote access security -------------------------------------------------
ENABLE_AUTH=false
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme123
# Comma-separated IPs/CIDRs, e.g. 192.168.1.0/24,10.0.0.1 (empty = allow all)
ALLOWED_IPS=
# Requests per minute per IP
RATE_LIMIT=100
